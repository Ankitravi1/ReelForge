# Autitic Studio Environment Configuration Template
# Copy this file to .env and fill in your keys.
# .env is gitignored to protect your secrets.

# --- LLM Provider (deepseek | openai | ollama) ---
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
AUTITIC_LLM_PROVIDER=deepseek
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# --- Stock Media (Optional) ---
PEXELS_API_KEY=

# --- Remote GPU Acceleration (Google Colab Wan2GP / Z-Image-Turbo) ---
COLAB_WAN2GP_URL=https://autitic-wan2gp.trycloudflare.com
AUTITIC_TOKEN=

# --- Data Directory Path ---
# Defaults to ./data if unset
AUTITIC_DATA_DIR=
